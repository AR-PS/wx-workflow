export MPASOUT_INTERVAL=none
export POST_GROUP_TOT_NUM=1 # num of groups, the final group absorbs leftovers, the first group contains the extra f000h file

export IC_OFFSET=6
#
export RETRO_PERIOD="2024050600-2024050700"
